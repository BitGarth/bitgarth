#!/usr/bin/env bash

set -euo pipefail

json_escape() {
  local value="${1:-}"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '%s' "${value}"
}

json_string_or_null() {
  local value="${1:-}"
  if [[ -z "${value}" ]]; then
    printf 'null'
  else
    printf '"%s"' "$(json_escape "${value}")"
  fi
}

if (( $# < 2 )); then
  echo "usage: $0 <test-type> <command...>" >&2
  exit 2
fi

TEST_TYPE="$1"
shift

IFS='|' read -r RUN_TIMESTAMP RUN_TIMESTAMP_UTC <<< "$(date -u +"%Y-%m-%dT%H-%M-%SZ|%Y-%m-%dT%H:%M:%SZ")"
RUN_DIR="test-results/${TEST_TYPE}/${RUN_TIMESTAMP}"
LOGS_DIR="${RUN_DIR}/logs"
LOG_FILE="${LOGS_DIR}/cargo-test.log"
RUN_JSON="${RUN_DIR}/run.json"
SUMMARY_FILE="${RUN_DIR}/summary.md"

mkdir -p "${LOGS_DIR}"

COMMAND_STRING="$(printf '%q ' "$@")"
COMMAND_STRING="${COMMAND_STRING% }"
START_MS="$(perl -MTime::HiRes=time -e 'printf("%.0f\n", time()*1000)')"

set +e
"$@" 2>&1 | tee "${LOG_FILE}"
EXIT_CODE=${PIPESTATUS[0]}
set -e

END_MS="$(perl -MTime::HiRes=time -e 'printf("%.0f\n", time()*1000)')"
DURATION_MS=$((END_MS - START_MS))
GIT_COMMIT="$(git rev-parse HEAD 2>/dev/null || true)"
if [[ -n "$(git status --short 2>/dev/null || true)" ]]; then
  GIT_DIRTY=true
else
  GIT_DIRTY=false
fi

SUMMARY_LINE="$(grep 'test result:' "${LOG_FILE}" | tail -n 1 || true)"
TEST_COUNT=null
PASSED_COUNT=null
FAILED_COUNT=null
IGNORED_COUNT=null

if [[ "${SUMMARY_LINE}" =~ ([0-9]+)[[:space:]]passed\;\ ([0-9]+)[[:space:]]failed\;\ ([0-9]+)[[:space:]]ignored ]]; then
  PASSED_COUNT="${BASH_REMATCH[1]}"
  FAILED_COUNT="${BASH_REMATCH[2]}"
  IGNORED_COUNT="${BASH_REMATCH[3]}"
  TEST_COUNT=$((PASSED_COUNT + FAILED_COUNT + IGNORED_COUNT))
fi

cat > "${RUN_JSON}" <<EOF
{
  "test_type": "$(json_escape "${TEST_TYPE}")",
  "timestamp_utc": "$(json_escape "${RUN_TIMESTAMP_UTC}")",
  "run_dir": "$(json_escape "${RUN_DIR}")",
  "project_dir": null,
  "command": "$(json_escape "${COMMAND_STRING}")",
  "exit_code": ${EXIT_CODE},
  "git_commit": $(json_string_or_null "${GIT_COMMIT}"),
  "git_dirty": ${GIT_DIRTY},
  "duration_ms": ${DURATION_MS},
  "test_count": ${TEST_COUNT},
  "passed_count": ${PASSED_COUNT},
  "failed_count": ${FAILED_COUNT},
  "ignored_count": ${IGNORED_COUNT},
  "notes": "cargo wrapper run"
}
EOF

cat > "${SUMMARY_FILE}" <<EOF
# Test Run Summary

- test_type: \`${TEST_TYPE}\`
- timestamp_utc: \`${RUN_TIMESTAMP_UTC}\`
- run_dir: \`${RUN_DIR}\`
- log_file: \`${LOG_FILE}\`
- exit_code: \`${EXIT_CODE}\`
- duration_ms: \`${DURATION_MS}\`
- test_count: \`${TEST_COUNT}\`
- passed_count: \`${PASSED_COUNT}\`
- failed_count: \`${FAILED_COUNT}\`
- ignored_count: \`${IGNORED_COUNT}\`
EOF

exit "${EXIT_CODE}"
